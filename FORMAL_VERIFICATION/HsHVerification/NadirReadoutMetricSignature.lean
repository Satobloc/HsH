import Mathlib

/-!
# Nadir: adapted readout metric and the real-signature obstruction

Source boundary:
* WORKSPACES/NADIR_VOSS/PLAYGROUND_003_CARTAN_SIM4_BACKBONE.md defines the
  candidate readout metric g = δ - 2 u♭ ⊗ u♭ and chooses adapted coordinates
  u = ∂_w, giving diag(-1,+1,+1,+1).
* This file formalizes only that adapted-coordinate algebraic candidate.
  It does not prove that a physical u-field exists, that it is generated by
  the finite core, or that the candidate is the Kerr metric.

The determinant theorem below rules out a real metric-preserving congruence
between this Lorentzian form and the positive Euclidean identity form.
A physical bridge must therefore be an explicitly specified metric
redefinition, non-isometric projection, or complexified/analytic continuation;
it cannot be silently treated as a real coordinate isometry.
-/

namespace HsHVerification.NadirReadoutMetricSignature

abbrev Mat4 := Matrix (Fin 4) (Fin 4) ℝ

/-- Positive Euclidean metric in the adapted coordinate frame. -/
def euclideanMetric : Mat4 := 1

/-- Adapted resolving axis u = ∂_w = e₀. -/
def resolvingAxis : Fin 4 → ℝ := fun i => if i = 0 then 1 else 0

/-- The source's rank-one sign-flip formula, written componentwise. -/
def rankOneFlip : Mat4 :=
  fun i j => (if i = j then 1 else 0) -
    2 * resolvingAxis i * resolvingAxis j

/-- Candidate g = δ - 2 u♭ ⊗ u♭ in coordinates adapted to u. -/
def readoutMetric : Mat4 :=
  Matrix.diagonal (fun i : Fin 4 => if i = 0 then (-1 : ℝ) else 1)

/-- The diagonal readout form is exactly the source's rank-one sign flip. -/
theorem readoutMetric_eq_rankOneFlip :
    readoutMetric = rankOneFlip := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [readoutMetric, rankOneFlip, resolvingAxis, Matrix.diagonal]

/-- The distinguished resolving direction is negative for g. -/
theorem readoutMetric_time_axis :
    readoutMetric 0 0 = -1 := by
  simp [readoutMetric]

/-- Each of the three adapted spatial coordinate directions is positive. -/
theorem readoutMetric_spatial_axes (i : Fin 4) (hi : i ≠ 0) :
    readoutMetric i i = 1 := by
  simp [readoutMetric, hi]

/-- The adapted Lorentzian readout form has negative determinant. -/
theorem det_readoutMetric :
    Matrix.det readoutMetric = -1 := by
  simp [readoutMetric, Matrix.det_diagonal]

/-- The positive Euclidean identity form has positive determinant. -/
theorem det_euclideanMetric :
    Matrix.det euclideanMetric = 1 := by
  simp [euclideanMetric]

/-- Determinant of a real congruence Aᵀ G A. -/
theorem det_congruence (A G : Mat4) :
    Matrix.det (A.transpose * G * A) =
      (Matrix.det A) ^ 2 * Matrix.det G := by
  simp only [Matrix.det_mul, Matrix.det_transpose]
  ring

/--
No real 4×4 matrix can turn the adapted Lorentzian readout form into the
positive Euclidean identity by congruence. This is stronger than excluding
invertible isometries: the equation is impossible even without separately
assuming A is invertible.
-/
theorem no_real_congruence_to_euclidean (A : Mat4) :
    A.transpose * readoutMetric * A ≠ euclideanMetric := by
  intro h
  have hdet := congrArg Matrix.det h
  rw [det_congruence A readoutMetric, det_readoutMetric,
    det_euclideanMetric] at hdet
  nlinarith [sq_nonneg (Matrix.det A)]

#print axioms readoutMetric_eq_rankOneFlip
#print axioms readoutMetric_time_axis
#print axioms readoutMetric_spatial_axes
#print axioms det_readoutMetric
#print axioms det_congruence
#print axioms no_real_congruence_to_euclidean

end HsHVerification.NadirReadoutMetricSignature
