namespace HsHVerification.RavelTc99LevelGate

structure NuclearLevel where
  A : Nat
  Z : Nat
  levelId : Nat
  deriving DecidableEq, Repr

def tc99Ground : NuclearLevel := ⟨99, 43, 0⟩
def tc99Isomer : NuclearLevel := ⟨99, 43, 1⟩

def qFund (s : NuclearLevel) : Nat := 3 * s.A
def qZKey (s : NuclearLevel) : Nat × Nat := (qFund s, s.Z)

theorem same_nuclide_key : qZKey tc99Ground = qZKey tc99Isomer := by
  decide

theorem distinct_nuclear_levels : tc99Ground ≠ tc99Isomer := by
  decide

theorem qz_not_injective : ¬ Function.Injective qZKey := by
  intro hinj
  exact distinct_nuclear_levels (hinj same_nuclide_key)

theorem no_inverse_of_qz :
    ¬ ∃ recover : Nat × Nat → NuclearLevel,
      ∀ s : NuclearLevel, recover (qZKey s) = s := by
  rintro ⟨recover, h⟩
  have eq : tc99Ground = tc99Isomer := by
    calc
      tc99Ground = recover (qZKey tc99Ground) := (h tc99Ground).symm
      _ = recover (qZKey tc99Isomer) := congrArg recover same_nuclide_key
      _ = tc99Isomer := h tc99Isomer
  exact distinct_nuclear_levels eq

/-- ENSDF level energies in keV. The isomer uncertainty is 0.0011 keV.
    These are measured inputs, not generated by the historical SAT Q rule. -/
def groundEnergy : ℚ := 0
def isomerEnergy : ℚ := 1426836 / 10000

theorem observed_levels_differ : groundEnergy ≠ isomerEnergy := by
  norm_num [groundEnergy, isomerEnergy]

/-- No single-valued level energy depending ONLY on (Q=3A,Z) can reproduce
    both measured 99Tc levels. This does not exclude additional mode data. -/
theorem no_qz_only_level_energy :
    ¬ ∃ energyByQZ : Nat × Nat → ℚ,
      energyByQZ (qZKey tc99Ground) = groundEnergy ∧
      energyByQZ (qZKey tc99Isomer) = isomerEnergy := by
  rintro ⟨f, h0, h1⟩
  have heq : groundEnergy = isomerEnergy := by
    calc
      groundEnergy = f (qZKey tc99Ground) := h0.symm
      _ = f (qZKey tc99Isomer) := congrArg f same_nuclide_key
      _ = isomerEnergy := h1
  exact observed_levels_differ heq

/-- Adding a state-level label distinguishes the two observed states.
    It does NOT establish global physical completeness of the label. -/
theorem level_labels_different : tc99Ground.levelId ≠ tc99Isomer.levelId := by
  decide

end HsHVerification.RavelTc99LevelGate
