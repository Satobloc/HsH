import Mathlib

/-!
# Orson P1: leave-one-out initial-majority alignment

Source-conditional formalization of a new descriptive reanalysis of the 17
archived ConsistencyBench CGD result blobs listed in manifest blob
a2e21227dda53d867afcef771060fd39f8d6ae47.

The original evaluator source is aayambansal/ConsistencyBench
src/evaluate.py, blob 0453540cb7c19227601e59fb342fa93e736da849.

For each model-question record, the reference is the strict majority among
the other models' valid INITIAL labels for that same question. A changed
final label is classified as moving toward that fixed reference, away from
it, or neither. This is a retrospective cross-model alignment statistic:
the models did not see one another's answers. Published benchmark keys are
used only as source-key-relative scoring proxies, not semantic truth.

The constants below are inputs recovered by two independently implemented
replays. Lean checks the encoded arithmetic and conditional classification;
it does not authenticate the source, adjudicate meaning, establish causality,
or turn these archived outputs into independent trials.
-/

namespace HsHVerification
namespace OrsonP1PeerMajorityAlignment

inductive Movement where
  | toward
  | away
  | other
  deriving DecidableEq, Repr

def matchIndicator {α : Type*} [DecidableEq α]
    (majority answer : α) : Int :=
  if answer = majority then 1 else 0

def classify {α : Type*} [DecidableEq α]
    (majority initial final : α) : Movement :=
  if initial ≠ majority && final = majority then .toward
  else if initial = majority && final ≠ majority then .away
  else .other

def signedMovement : Movement → Int
  | .toward => 1
  | .away => -1
  | .other => 0

/-- A move toward the fixed peer-majority reference adds one match. -/
theorem peer_match_delta_is_classified_movement
    {α : Type*} [DecidableEq α]
    (majority initial final : α) :
    matchIndicator majority final - matchIndicator majority initial =
      signedMovement (classify majority initial final) := by
  by_cases hi : initial = majority <;>
    by_cases hf : final = majority <;>
    simp [matchIndicator, classify, signedMovement, hi, hf]

/-- A revision away from the fixed peer-majority reference removes one match. -/
theorem away_move_has_negative_alignment_delta
    {α : Type*} [DecidableEq α]
    (majority initial final : α)
    (hi : initial = majority) (hf : final ≠ majority) :
    matchIndicator majority final - matchIndicator majority initial = -1 := by
  simp [matchIndicator, hf, hi]

/-- A revision toward the fixed peer-majority reference adds one match. -/
theorem toward_move_has_positive_alignment_delta
    {α : Type*} [DecidableEq α]
    (majority initial final : α)
    (hi : initial ≠ majority) (hf : final = majority) :
    matchIndicator majority final - matchIndicator majority initial = 1 := by
  simp [matchIndicator, hf, hi]

/-! Replayed complete-case counts. These are data inputs, not generated by Lean. -/

def rawRecords : Nat := 19550
def eligibleRecords : Nat := 18331
def excludedNonClassRecords : Nat := 1219

def changedRecords : Nat := 1616
def majorityDefinedChanged : Nat := 1408
def noMajorityChanged : Nat := 208
def towardCount : Nat := 489
def awayCount : Nat := 878
def otherMajorityDefinedCount : Nat := 41

def majorityDefinedRecords : Nat := 17258
def initialPeerMajorityMatches : Nat := 14088
def finalPeerMajorityMatches : Nat := 13699

def sourceKeyGainCount : Nat := 1096
def sourceKeyLossCount : Nat := 405
def sourceKeyUnchangedCount : Nat := 115

theorem eligible_and_excluded_partition :
    eligibleRecords + excludedNonClassRecords = rawRecords := by
  norm_num [eligibleRecords, excludedNonClassRecords, rawRecords]

theorem majority_defined_revision_partition :
    towardCount + awayCount + otherMajorityDefinedCount =
      majorityDefinedChanged := by
  norm_num [towardCount, awayCount, otherMajorityDefinedCount,
    majorityDefinedChanged]

theorem all_changed_revision_partition :
    majorityDefinedChanged + noMajorityChanged = changedRecords := by
  norm_num [majorityDefinedChanged, noMajorityChanged, changedRecords]

theorem source_key_transition_partition :
    sourceKeyGainCount + sourceKeyLossCount + sourceKeyUnchangedCount =
      changedRecords := by
  norm_num [sourceKeyGainCount, sourceKeyLossCount,
    sourceKeyUnchangedCount, changedRecords]

/-- The observed change in all eligible leave-one-out majority matches
equals the signed sum of toward and away revisions. -/
theorem net_peer_alignment_change_equals_turnover_net :
    (finalPeerMajorityMatches : Int) -
      (initialPeerMajorityMatches : Int) =
      (towardCount : Int) - (awayCount : Int) := by
  norm_num [finalPeerMajorityMatches, initialPeerMajorityMatches,
    towardCount, awayCount]

theorem net_peer_alignment_change_is_negative_389 :
    (finalPeerMajorityMatches : Int) -
      (initialPeerMajorityMatches : Int) = -389 := by
  norm_num [finalPeerMajorityMatches, initialPeerMajorityMatches]

theorem strict_peer_majority_match_rate_falls :
    (finalPeerMajorityMatches : ℚ) / (majorityDefinedRecords : ℚ) <
      (initialPeerMajorityMatches : ℚ) /
        (majorityDefinedRecords : ℚ) := by
  norm_num [finalPeerMajorityMatches, initialPeerMajorityMatches,
    majorityDefinedRecords]

theorem away_revisions_outnumber_toward :
    awayCount > towardCount := by
  norm_num [awayCount, towardCount]

theorem source_key_gains_outnumber_losses :
    sourceKeyGainCount > sourceKeyLossCount := by
  norm_num [sourceKeyGainCount, sourceKeyLossCount]

