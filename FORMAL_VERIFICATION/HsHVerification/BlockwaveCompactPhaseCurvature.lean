namespace HsHVerification.BlockwaveCompactPhaseCurvature

/-- A constant multiple of the exact 1-form generated by a smooth local
0-form has zero local exterior curvature. The degree-zero form is the
local chart representative of a smooth phase lift. -/
theorem local_curvature_zero
    {𝕜 E F : Type*}
    [NontriviallyNormedField 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E]
    [NormedAddCommGroup F] [NormedSpace 𝕜 F]
    (theta : E → E [⋀^Fin 0]→L[𝕜] F)
    (alpha : 𝕜)
    (hTheta : ContDiff 𝕜 ⊤ theta) :
    extDeriv (alpha • extDeriv theta) = 0 := by
  ext x
  rw [extDeriv_smul]
  rw [extDeriv_extDeriv hTheta (by simp)]
  simp

#print axioms local_curvature_zero

end HsHVerification.BlockwaveCompactPhaseCurvature
