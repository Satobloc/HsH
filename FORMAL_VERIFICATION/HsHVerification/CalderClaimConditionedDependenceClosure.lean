import Mathlib
import HsHVerification.CalderUnitLineageHoldout
import HsHVerification.CalderIndependenceProfile

/-!
# Claim-conditioned dependence closure for calibration/holdout partitions

A channel-to-acquisition map prevents channels from one declared acquisition
unit being split across folds. It does not by itself prevent two distinct
acquisition units that share a claim-relevant dependency from crossing folds.

This module adds a second, claim-conditioned closure layer. Required
co-group edges define connected components that must remain in one fold.
Shared nuisance edges are different: they may cross folds only when a
source-backed covariance/model witness is supplied. Disclosure-only edges
must be recorded but do not themselves impose a grouping rule. Unresolved
required edges fail closed.

The proof concerns only the abstract graph/fold relation. It does not
authenticate source locators, establish that a dependency classification is
correct, prove statistical independence, estimate covariance, or validate a
physical/H(s)H model. No physical fixture or data-free physical calculation
is represented here.
-/

open HsHVerification.CalderIndependenceProfile

namespace HsHVerification.CalderClaimConditionedDependenceClosure

/-- A dependency axis or lineage relationship relevant to a declared claim. -/
inductive DependencyKind
  | samePhysicalEvent
  | sameEventVersionLineage
  | sameRawAcquisition
  | derivedFromSameAcquisition
  | samePosteriorOrAnalysisRun
  | sameSimulationRealization
  | sharedInstrument
  | sharedCalibrationDataset
  | sharedPSDOrDataQuality
  | sharedAnalysisPipeline
  | sharedPriorOrTemplate
  | samePublicationLineage
  | sharedLaboratoryOrCollaboration
  deriving DecidableEq, Repr

/-- Claim-specific treatment of a dependency edge. -/
inductive DependencyTreatment
  | coGroup
  | modelSharedNuisance
  | discloseOnly
  | unresolved
  deriving DecidableEq, Repr

/--
A source-addressed relation between two declared acquisition units.
covarianceModel is required when the claim policy allows a shared nuisance
to cross folds rather than co-grouping its endpoints.
-/
structure DependencyEdge (Unit : Type*) where
  left : Unit
  right : Unit
  kind : DependencyKind
  treatment : DependencyTreatment
  source : EvidenceLocator
  covarianceModel : Option EvidenceLocator := none

/-- Required unresolved edges are not admissible. -/
def DependencyEdgeAdmissible {Unit : Type*} (edge : DependencyEdge Unit) : Prop :=
  edge.treatment ≠ .unresolved ∧
    (edge.treatment = .modelSharedNuisance → edge.covarianceModel.isSome = true)

theorem unresolved_dependency_edge_blocks_admission
    {Unit : Type*}
    (edge : DependencyEdge Unit)
    (hUnresolved : edge.treatment = .unresolved) :
    ¬ DependencyEdgeAdmissible edge := by
  intro h
  exact h.1 hUnresolved

theorem shared_nuisance_without_covariance_blocks_admission
    {Unit : Type*}
    (edge : DependencyEdge Unit)
    (hShared : edge.treatment = .modelSharedNuisance)
    (hNoCovariance : edge.covarianceModel = none) :
    ¬ DependencyEdgeAdmissible edge := by
  intro h
  have hCovariance := h.2 hShared
  rw [hNoCovariance] at hCovariance
  cases hCovariance

/--
The undirected relation generated by source-recorded edges whose
claim-specific treatment requires their endpoints to remain in one fold.
-/
def MustGroupRelation {Unit : Type*}
    (edges : List (DependencyEdge Unit)) (u v : Unit) : Prop :=
  ∃ edge, edge ∈ edges ∧ edge.treatment = .coGroup ∧
    ((edge.left = u ∧ edge.right = v) ∨ (edge.left = v ∧ edge.right = u))

/-- Finite or infinite paths through required co-group edges. -/
inductive DependencyPath {Unit : Type*}
    (mustGroup : Unit → Unit → Prop) : Unit → Unit → Prop
  | refl (u : Unit) : DependencyPath mustGroup u u
  | step {u v w : Unit} :
      mustGroup u v →
      DependencyPath mustGroup v w →
      DependencyPath mustGroup u w

/-- A fold assignment respects every edge that the claim policy says to co-group. -/
def FoldRespectsCoGroupEdges {Unit Fold : Type*}
    (edges : List (DependencyEdge Unit))
    (foldOf : Unit → Fold) : Prop :=
  ∀ edge, edge ∈ edges → edge.treatment = .coGroup →
    foldOf edge.left = foldOf edge.right

/--
If every required co-group edge stays in one fold, then every connected
component of the co-group graph stays in one fold.
-/
theorem grouped_dependency_path_preserves_fold
    {Unit Fold : Type*}
    (edges : List (DependencyEdge Unit))
    (foldOf : Unit → Fold)
    (hSafe : FoldRespectsCoGroupEdges edges foldOf) :
    ∀ {u v},
      DependencyPath (MustGroupRelation edges) u v →
      foldOf u = foldOf v := by
  intro u v hPath
  induction hPath with
  | refl u => rfl
  | step hEdge hTail ih =>
      rcases hEdge with ⟨edge, hMem, hGroup, hOrientation⟩
      have hEdgeEq : foldOf u = foldOf v := by
        rcases hOrientation with ⟨hLeft, hRight⟩ | ⟨hLeft, hRight⟩
        · calc
            foldOf u = foldOf edge.left := congrArg foldOf hLeft.symm
            _ = foldOf edge.right := hSafe edge hMem hGroup
            _ = foldOf v := congrArg foldOf hRight
        · calc
            foldOf u = foldOf edge.right := congrArg foldOf hRight.symm
            _ = foldOf edge.left := (hSafe edge hMem hGroup).symm
            _ = foldOf v := congrArg foldOf hLeft
      exact hEdgeEq.trans ih

/--
Composes with the existing channel-to-acquisition factorization: if channel
folds descend to acquisition-unit folds, channels whose acquisition units
are connected by required co-group dependencies cannot be split.
-/
theorem channel_fold_constant_on_dependency_path
    {Channel Unit Fold : Type*}
    (unitOf : Channel → Unit)
    (channelFold : Channel → Fold)
    (unitFold : Unit → Fold)
    (hFactor : ∀ c, channelFold c = unitFold (unitOf c))
    (edges : List (DependencyEdge Unit))
    (hSafe : FoldRespectsCoGroupEdges edges unitFold)
    {c₁ c₂ : Channel}
    (hPath :
      DependencyPath (MustGroupRelation edges) (unitOf c₁) (unitOf c₂)) :
    channelFold c₁ = channelFold c₂ := by
  calc
    channelFold c₁ = unitFold (unitOf c₁) := hFactor c₁
    _ = unitFold (unitOf c₂) :=
      grouped_dependency_path_preserves_fold edges unitFold hSafe hPath
    _ = channelFold c₂ := (hFactor c₂).symm

/-- A cross-fold pair cannot be connected by required co-group dependencies. -/
theorem cross_fold_excludes_grouped_dependency_path
    {Unit Fold : Type*}
    (edges : List (DependencyEdge Unit))
    (foldOf : Unit → Fold)
    (hSafe : FoldRespectsCoGroupEdges edges foldOf)
    {u v : Unit}
    (hDifferent : foldOf u ≠ foldOf v) :
    ¬ DependencyPath (MustGroupRelation edges) u v := by
  intro hPath
  exact hDifferent (grouped_dependency_path_preserves_fold edges foldOf hSafe hPath)

#print axioms unresolved_dependency_edge_blocks_admission
#print axioms shared_nuisance_without_covariance_blocks_admission
#print axioms grouped_dependency_path_preserves_fold
#print axioms channel_fold_constant_on_dependency_path
#print axioms cross_fold_excludes_grouped_dependency_path

end HsHVerification.CalderClaimConditionedDependenceClosure
