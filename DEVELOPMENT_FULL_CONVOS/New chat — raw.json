          "text": "bash -lc /bin/bash -lc \"set -e\npython3 -m py_compile visual_archive_indexer.py\npython3 - <<'PY'\nfrom pathlib import Path\nfrom PIL import Image, ImageDraw\nimport fitz\nroot=Path('/tmp/visual-indexer-test')\nroot.mkdir(exist_ok=True)\nfor name,color in [('2026-09-20_red.png',(220,30,30)),('blue.jpg',(20,70,220)),('red-copy.png',(220,30,30))]:\n    im=Image.new('RGB',(180,120),color)\n    ImageDraw.Draw(im).ellipse((45,20,135,110),outline='white',width=4)\n    im.save(root/name)\ndoc=fitz.open(); p=doc.new_page(); p.insert_text((72,72),'Visual PDF page',fontsize=24); doc.save(root/'sample.pdf'); doc.close()\nPY\npython3 visual_archive_indexer.py /tmp/visual-indexer-test --quiet\nlatest=\"'$(find /tmp/visual-indexer-test -maxdepth 1 -type d -name '\"'VISUAL_INDEX_*' | sort | tail -1)\npython3 - <<'PY' \\\"\"'$latest\"\nimport json,sys\nfrom pathlib import Path\np=Path(sys.argv[1])\ndata=json.loads((p/'\"'visual-index.json').read_text())\nassert len(data['records'])==4, len(data['records'])\nassert (p/'index.html').exists() and (p/'visual-index.csv').exists()\nprint({'output':str(p),'records':len(data['records']),'failures':len(data['failures']),'exact_groups':sorted(set(r['exact_group'] for r in data['records'] if r['exact_group']))})\nPY\npython3 visual_archive_indexer.py --help | head -25\""
